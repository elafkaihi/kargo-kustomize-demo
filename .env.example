# Copy to .env (gitignored) and fill in. Never commit .env.
# Token needs: Contents read/write on the repo (and repo creation if it doesn't exist yet).
GITHUB_TOKEN=
GITHUB_USER=your-github-user
REPO_NAME=kargo-kustomize-demo
# Optional: where release.sh copies podinfo images from.
# IMAGE_SOURCE=ghcr.io/stefanprodan/podinfo
# Optional: Docker subnet for the k3d network (must not overlap with VPN routes).
# K3D_SUBNET=198.18.0.0/24
